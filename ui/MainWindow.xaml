<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResumeGrabber" Width="1180" Height="800" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#202020" Foreground="#FFFFFF" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentDim" Color="#1F3A4A"/>
    <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#363636"/>
    <SolidColorBrush x:Key="Sub" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Faint" Color="#7A7A7A"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#353535"/>
      <Setter Property="BorderBrush" Value="#454545"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3F3F3F"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#0B1A22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#4CC2FF" BorderBrush="#7DD3FF" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#62CBFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#3AA8E0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#3A3A3A"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="#8A8A8A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="10"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#333333"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- sidebar navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="14,11">
                <ContentPresenter/>
              </Border>
              <Border x:Name="pill" Width="3" Height="18" CornerRadius="2" Background="#4CC2FF"
                      HorizontalAlignment="Left" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#2A2A2A"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#2D2D2D"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented option (quality / layout) -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#313131" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="16,12" MinWidth="170">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#383838"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#4CC2FF"/>
                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                <Setter TargetName="b" Property="Background" Value="#25323A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="track" Grid.Column="1" Width="44" Height="22" CornerRadius="11" Background="Transparent"
                      BorderBrush="#9A9A9A" BorderThickness="1.5" Margin="16,0,0,0">
                <Ellipse x:Name="knob" Width="12" Height="12" Fill="#CFCFCF" HorizontalAlignment="Left" Margin="4,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#4CC2FF"/>
                <Setter TargetName="track" Property="BorderBrush" Value="#4CC2FF"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="#0B1A22"/>
                <Setter TargetName="knob" Property="Width" Value="14"/>
                <Setter TargetName="knob" Property="Height" Value="14"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="#1F3A4A"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StepNum" TargetType="Border">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Background" Value="#1F3A4A"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===================== title bar ===================== -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
        <Border Width="30" Height="30" CornerRadius="7">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#00C8FF" Offset="0"/>
              <GradientStop Color="#BE28DC" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="White"/>
        </Border>
        <TextBlock Text="ResumeGrabber" FontSize="16" FontWeight="SemiBold" Margin="12,0,10,0" VerticalAlignment="Center"/>
        <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5" Padding="7,1" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" Text="v3.0" FontSize="12" Foreground="{StaticResource Sub}"/>
        </Border>
        <Border Background="#16301F" CornerRadius="5" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="#6CCB5F" Margin="0,0,6,0"/>
            <TextBlock Text="Portable - nothing installed" FontSize="12" Foreground="#6CCB5F"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinBtn"   Style="{StaticResource Chrome}" Content="&#xE921;"/>
        <Button x:Name="MaxBtn"   Style="{StaticResource Chrome}" Content="&#xE922;"/>
        <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" Content="&#xE8BB;"/>
      </StackPanel>
    </Grid>

    <!-- ===================== body ===================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Grid Grid.Column="0" Margin="14,6,14,16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <RadioButton x:Name="NavGrab" Style="{StaticResource Nav}" IsChecked="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,16,0"/>
              <TextBlock Text="Grab resume" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavPreview" Style="{StaticResource Nav}">
            <Grid Width="200">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" Margin="0,0,16,0"/>
                <TextBlock Text="Preview" VerticalAlignment="Center"/>
              </StackPanel>
              <Border x:Name="PreviewBadge" Style="{StaticResource Badge}" HorizontalAlignment="Right" Visibility="Collapsed">
                <TextBlock x:Name="PreviewBadgeText" Text="1" FontSize="12" Foreground="{StaticResource Accent}"/>
              </Border>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,16,0"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>

          <Border Height="1" Background="#333333" Margin="12,16"/>
          <TextBlock Text="THIS SESSION" FontSize="12" Foreground="{StaticResource Faint}" Margin="14,0,0,8"/>
          <Grid Margin="14,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" Foreground="{StaticResource Sub}" Margin="0,0,16,0"/>
              <TextBlock Text="PNGs saved" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
              <TextBlock x:Name="SavedCount" Text="0" FontSize="12" Foreground="{StaticResource Accent}"/>
            </Border>
          </Grid>
          <Grid Margin="14,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{StaticResource Sub}" Margin="0,0,16,0"/>
              <TextBlock Text="Temp to delete" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
              <TextBlock x:Name="TempSize" Text="0 MB" FontSize="12" Foreground="{StaticResource Accent}"/>
            </Border>
          </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="16,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" Foreground="#6CCB5F" Margin="0,0,10,0"/>
              <TextBlock Text="Leaves no trace" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"
                       Text="Runs from a temporary folder that is wiped the moment you close this window. Only your PNG stays on your PC."/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- content -->
      <Border Grid.Column="1" Background="#272727" CornerRadius="8,0,0,0" BorderBrush="#2F2F2F" BorderThickness="1,1,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- =============== page: grab =============== -->
          <ScrollViewer x:Name="PageGrab" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,36,48,36">
              <TextBlock Text="Grab your resume" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,8,0,26"
                         Text="Turns your resume.io resume into a crisp PNG using resume.io's own renderer. Nothing is installed, and everything except your PNG is deleted when you close this window."/>

              <UniformGrid Columns="4" Margin="-8,0,-8,0">
                <Border Style="{StaticResource CardBox}" Margin="8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <TextBlock Text="Runtime" Foreground="{StaticResource Sub}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="CardNodeTitle" Text="Preparing..." FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock x:Name="CardNodeSub" Text="portable Node.js" Foreground="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}" Margin="8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <TextBlock Text="Renderer" Foreground="{StaticResource Sub}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="CardEngineTitle" Text="Waiting..." FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock x:Name="CardEngineSub" Text="resume.io engine" Foreground="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}" Margin="8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <TextBlock Text="Saves to" Foreground="{StaticResource Sub}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="CardOutTitle" Text="Downloads" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CardOutSub" Text="" Foreground="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}" Margin="8,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <TextBlock Text="Output" Foreground="{StaticResource Sub}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="CardFmtTitle" Text="PNG - High" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock x:Name="CardFmtSub" Text="220 DPI, all pages in one image" Foreground="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- detected resume -->
              <Border x:Name="DetectedCard" Margin="0,20,0,0" CornerRadius="8" BorderThickness="2" BorderBrush="#4CC2FF"
                      Background="#25323A" Padding="22,18" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="48" Height="48" CornerRadius="8" Background="#1F3A4A" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="DetectedName" Text="Your resume" FontSize="20" FontWeight="SemiBold"/>
                      <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                        <TextBlock Text="Ready" FontSize="12" Foreground="{StaticResource Accent}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetectedSub" Text="" Foreground="{StaticResource Sub}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="DetectedCreateBtn" Grid.Column="2" Style="{StaticResource Primary}" Padding="20,10">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                      <TextBlock Text="Create PNG"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <!-- steps -->
              <Border Style="{StaticResource CardBox}" Margin="0,20,0,0" Padding="26,22">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/>
                      <TextBlock Text="Get your resume in 3 copies" Style="{StaticResource H2}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClipWatchText" Text="Watching your clipboard" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Sub}"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,10" FontSize="13"
                             Text="Sign in to resume.io in your browser first. In Chrome or Edge just press Ctrl+A then Ctrl+C on each page that opens (Firefox: click Raw Data first). ResumeGrabber picks it up automatically."/>

                  <!-- step 1 -->
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="Step1Num" Style="{StaticResource StepNum}">
                      <TextBlock x:Name="Step1Glyph" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0">
                      <TextBlock Text="Open your resume list" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Step1Text" Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13" Text="Opens resume.io/api/app/resumes. Copy the page with Ctrl+A, Ctrl+C."/>
                    </StackPanel>
                    <Button x:Name="OpenListBtn" Grid.Column="2" Style="{StaticResource Btn}" VerticalAlignment="Top">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Open resume.io"/>
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- step 2 -->
                  <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Step2Num" Style="{StaticResource StepNum}">
                      <TextBlock x:Name="Step2Glyph" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0">
                      <TextBlock Text="Pick a resume" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Step2Text" Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13" Text="Your resumes appear here after step 1. Click one to open it."/>
                      <WrapPanel x:Name="ResumeList" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>

                  <!-- step 3 -->
                  <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Step3Num" Style="{StaticResource StepNum}">
                      <TextBlock x:Name="Step3Glyph" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0">
                      <TextBlock Text="Copy the resume page" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Step3Text" Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13" Text="Ctrl+A, Ctrl+C on the resume page. Your PNG is created right away."/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- alternatives -->
              <Border Style="{StaticResource CardBox}" Margin="0,20,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Already have the JSON?" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" Text="Open a saved resume .json, paste it, or drop the file anywhere on this window."/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenFileBtn" Style="{StaticResource Btn}" Margin="0,0,10,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Open file"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="PasteBtn" Style="{StaticResource Btn}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Paste"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =============== page: preview =============== -->
          <Grid x:Name="PagePreview" Visibility="Collapsed" Margin="48,36,48,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Preview" Style="{StaticResource H1}"/>
            <Grid Grid.Row="1" Margin="0,8,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PreviewPath" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Nothing created yet."/>
              <StackPanel x:Name="PreviewActions" Grid.Column="1" Orientation="Horizontal" IsEnabled="False">
                <Button x:Name="CopyImgBtn" Style="{StaticResource Btn}" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Copy image"/></StackPanel>
                </Button>
                <Button x:Name="SaveAsBtn" Style="{StaticResource Btn}" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE792;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Save as..."/></StackPanel>
                </Button>
                <Button x:Name="ShowFolderBtn" Style="{StaticResource Btn}" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Show in folder"/></StackPanel>
                </Button>
                <Button x:Name="OpenPngBtn" Style="{StaticResource Primary}" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open PNG"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="#1C1C1C" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
              <Grid>
                <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="48" Foreground="#4A4A4A" HorizontalAlignment="Center"/>
                  <TextBlock Text="Your PNG will show up here" Foreground="{StaticResource Faint}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                  <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="900" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.5"/></Image.Effect>
                  </Image>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <!-- =============== page: settings =============== -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,36,48,36">
              <TextBlock Text="Settings" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,8,0,26" Text="Settings last for this session only - nothing is written to your PC."/>

              <Border Style="{StaticResource CardBox}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Save PNGs to" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OutDirText" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Change..."/></StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Image quality" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,14" Text="Higher quality means a sharper, larger file."/>
                  <WrapPanel>
                    <RadioButton x:Name="Q150" Style="{StaticResource Seg}" GroupName="q">
                      <StackPanel><TextBlock Text="Standard" FontWeight="SemiBold"/><TextBlock Text="150 DPI - small file" Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Q220" Style="{StaticResource Seg}" GroupName="q" IsChecked="True">
                      <StackPanel><TextBlock Text="High" FontWeight="SemiBold"/><TextBlock Text="220 DPI - recommended" Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Q300" Style="{StaticResource Seg}" GroupName="q">
                      <StackPanel><TextBlock Text="Print" FontWeight="SemiBold"/><TextBlock Text="300 DPI - largest" Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Multi-page resumes" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,14" Text="How to save a resume that has more than one page."/>
                  <WrapPanel>
                    <RadioButton x:Name="LayoutOne" Style="{StaticResource Seg}" GroupName="l" IsChecked="True">
                      <StackPanel><TextBlock Text="One image" FontWeight="SemiBold"/><TextBlock Text="pages stacked top to bottom" Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LayoutPages" Style="{StaticResource Seg}" GroupName="l">
                      <StackPanel><TextBlock Text="One PNG per page" FontWeight="SemiBold"/><TextBlock Text="Page 1, Page 2, ..." Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LayoutBoth" Style="{StaticResource Seg}" GroupName="l">
                      <StackPanel><TextBlock Text="Both" FontWeight="SemiBold"/><TextBlock Text="combined + each page" Foreground="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </RadioButton>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
                <StackPanel>
                  <CheckBox x:Name="AutoCreateChk" Style="{StaticResource Switch}" IsChecked="True">
                    <StackPanel><TextBlock Text="Create the PNG as soon as a resume is copied" FontSize="15"/><TextBlock Text="Skip pressing the button after step 3." Foreground="{StaticResource Sub}" FontSize="13"/></StackPanel>
                  </CheckBox>
                  <Border Height="1" Background="#363636" Margin="0,14"/>
                  <CheckBox x:Name="OpenAfterChk" Style="{StaticResource Switch}" IsChecked="False">
                    <StackPanel><TextBlock Text="Open the PNG in Photos after saving" FontSize="15"/><TextBlock Text="The preview tab always shows it either way." Foreground="{StaticResource Sub}" FontSize="13"/></StackPanel>
                  </CheckBox>
                  <Border Height="1" Background="#363636" Margin="0,14"/>
                  <CheckBox x:Name="AlsoPdfChk" Style="{StaticResource Switch}" IsChecked="False">
                    <StackPanel><TextBlock Text="Also keep a PDF copy" FontSize="15"/><TextBlock Text="Vector PDF with selectable text, saved next to the PNG." Foreground="{StaticResource Sub}" FontSize="13"/></StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Language override" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" Text="Leave empty to use the resume's own language. Examples: en, es, de, fr, pt."/>
                  </StackPanel>
                  <TextBox x:Name="LocaleBox" Grid.Column="1" Width="120" Background="#1F1F1F" Foreground="White" BorderBrush="#454545"
                           CaretBrush="White" Padding="8,6" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
              </Border>

              <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="12" Margin="0,24,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- =============== bottom bar =============== -->
          <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="0,1,0,0" Background="#242424" Padding="48,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatusIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                  <TextBlock x:Name="StatusText" Text="Getting ready..." Foreground="#D0D0D0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ProgressBar x:Name="Busy" Height="3" Margin="24,8,0,0" IsIndeterminate="True" Foreground="#4CC2FF"
                             Background="#333333" BorderThickness="0" MaxWidth="420" HorizontalAlignment="Left" Width="420"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenOutBtn" Style="{StaticResource Btn}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open folder"/></StackPanel>
                </Button>
                <Button x:Name="CreateBtn" Style="{StaticResource Primary}" Padding="20,9" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Create PNG"/>
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- drop overlay -->
    <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#CC101418" Visibility="Collapsed" IsHitTestVisible="False">
      <Border BorderBrush="#4CC2FF" BorderThickness="2" CornerRadius="12" Margin="40" >
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="56" Foreground="#4CC2FF" HorizontalAlignment="Center"/>
          <TextBlock Text="Drop your resume .json" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
